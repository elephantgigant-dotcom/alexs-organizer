rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Alex's Organizer security rules
//
// Only ONE Google account may read or write anything:
// elephantgigant@gmail.com (verified email), and only inside its own
// users/{uid} folder. Anyone else who signs in sees nothing.
// Cloud Functions use the Admin SDK and are not affected by these rules.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'elephantgigant@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Profile + settings (theme, star values, PIN hash, reminder times…)
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // tasks, categories, checkins, meditations, starEvents, rewards, goals,
      // devices, pushTests …
      match /{collection}/{docId} {
        allow read: if isOwner(uid);
        // Weekly backups are written only by the server (Cloud Function)
        allow write: if isOwner(uid) && collection != 'weeklySummaries';
      }
    }

    // Everything else: closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
